{
  "$schema": "./node_modules/@ambleloft/extension-sdk/extension.schema.json",
  "specVersion": "1.0-draft",
  "publisher": "samples",
  "name": "extension-showcase",
  "version": "0.3.1",
  "displayName": "扩展能力体验馆",
  "description": "%description%",
  "engines": {
    "api": "1"
  },
  "main": "dist/extension.cjs",
  "permissions": [
    {
      "capability": "projects.read",
      "scope": "project"
    },
    {
      "capability": "projects.path.read",
      "scope": "project"
    },
    {
      "capability": "conversations.create",
      "scope": "project"
    },
    {
      "capability": "conversations.open",
      "scope": "project"
    },
    {
      "capability": "storage",
      "scope": "self"
    },
    {
      "capability": "configuration",
      "scope": "self"
    },
    {
      "capability": "secrets",
      "scope": "self"
    }
  ],
  "contextKeys": [
    {
      "key": "ext.samples.extension-showcase.linked",
      "type": "boolean",
      "default": false
    }
  ],
  "contributes": {
    "home": {
      "title": "%name%",
      "webRoot": "web",
      "entry": "index.html"
    },
    "commands": [
      {
        "id": "samples.extension-showcase.open",
        "title": "%open%",
        "action": "openHome"
      },
      {
        "id": "samples.extension-showcase.linkedHome",
        "title": "%linkedHome%",
        "action": "openHome",
        "when": "ext.samples.extension-showcase.linked"
      }
    ],
    "mcpApps": [
      {
        "uri": "ui://samples.extension-showcase/travel",
        "title": "差旅记录",
        "entry": "form.html",
        "mimeType": "text/html;profile=mcp-app"
      }
    ]
  },
