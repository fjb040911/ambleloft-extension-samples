{
  "specVersion": "1.0-draft",
  "publisher": "samples",
  "name": "enterprise-auth",
  "version": "0.1.0",
  "displayName": "%name%",
  "description": "%description%",
  "engines": {
    "api": "1"
  },
  "main": "dist/extension.cjs",
  "permissions": [],
  "contributes": {
    "home": {
      "title": "%name%",
      "webRoot": "web",
      "entry": "index.html"
    }
  },
  "operations": [
    {
      "id": "samples.enterprise-auth.status",
      "handler": "status",
      "title": "查询连接",
      "description": "查询连接",
      "exposeTo": ["page"],
      "effect": "read",
      "projectScoped": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 150000
          }
        },
        "required": ["data"],
        "additionalProperties": false
      },
      "requiredPermissions": []
    },
    {
      "id": "samples.enterprise-auth.connect",
      "handler": "connect",
      "title": "连接企业账号",
      "description": "连接企业账号",
      "exposeTo": ["page"],
      "effect": "write",
      "projectScoped": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 150000
          }
        },
        "required": ["data"],
        "additionalProperties": false
      },
      "requiredPermissions": [],
      "timeoutMs": 120000
    },
    {
      "id": "samples.enterprise-auth.disconnect",
      "handler": "disconnect",
      "title": "断开连接",
      "description": "断开连接",
      "exposeTo": ["page"],
      "effect": "write",
      "projectScoped": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 150000
          }
        },
        "required": ["data"],
        "additionalProperties": false
      },
      "requiredPermissions": []
    },
    {
      "id": "samples.enterprise-auth.request",
      "handler": "request",
      "title": "查询业务服务",
      "description": "查询业务服务",
      "exposeTo": ["page"],
      "effect": "read",
      "projectScoped": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 150000
          }
        },
        "required": ["data"],
        "additionalProperties": false
      },
      "requiredPermissions": []
    }
  ],
  "authentication": {
    "resources": [
      {
        "id": "business",
        "title": "企业业务服务",
        "baseUrl": "https://api.example.com/v1/",
        "audience": "https://api.example.com/",
        "scopes": ["tasks.read"]
      }
    ]
  }
}
