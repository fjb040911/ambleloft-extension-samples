{
  "specVersion": "1.0-draft",
  "publisher": "samples",
  "name": "operation-confirmation",
  "version": "0.1.0",
  "displayName": "%name%",
  "description": "%description%",
  "engines": {
    "api": "1"
  },
  "main": "dist/extension.cjs",
  "permissions": [
    {
      "capability": "storage",
      "scope": "self"
    }
  ],
  "contributes": {
    "home": {
      "title": "%name%",
      "webRoot": "web",
      "entry": "index.html"
    }
  },
  "operations": [
    {
      "id": "samples.operation-confirmation.read",
      "handler": "read",
      "title": "查询记录",
      "description": "查询记录",
      "exposeTo": ["page", "agent"],
      "effect": "read",
      "projectScoped": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 150000
          }
        },
        "required": ["data"],
        "additionalProperties": false
      },
      "requiredPermissions": ["storage"]
    },
    {
      "id": "samples.operation-confirmation.save",
      "handler": "save",
      "title": "添加记录",
      "description": "添加记录",
      "exposeTo": ["page", "agent"],
      "effect": "write",
      "projectScoped": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": ["text"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 150000
          }
        },
        "required": ["data"],
        "additionalProperties": false
      },
      "requiredPermissions": ["storage"]
    },
    {
      "id": "samples.operation-confirmation.remove",
      "handler": "remove",
      "title": "删除记录",
      "description": "删除记录",
      "exposeTo": ["page", "agent"],
      "effect": "write",
      "projectScoped": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 150000
          }
        },
        "required": ["data"],
        "additionalProperties": false
      },
      "requiredPermissions": ["storage"],
      "risk": {
        "reversible": false,
        "impacts": ["destructive"]
      }
    }
  ]
}
